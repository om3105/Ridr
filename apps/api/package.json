{
  "name": "@ridr/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node ../../scripts/api-dev.mjs",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:profiles": "tsc -p tsconfig.test.json && node --env-file=../../.env --test dist-test/test/profiles.integration.js",
    "test:rides": "tsc -p tsconfig.test.json && node --env-file=../../.env --test dist-test/test/rides.integration.js",
    "test:management": "tsc -p tsconfig.test.json && node --env-file=../../.env --test dist-test/test/ride-management.integration.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-socket.io": "11.2.3",
    "@nestjs/websockets": "11.2.3",
    "ffprobe-static": "3.1.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "saxes": "6.0.0",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "socket.io-client": "4.8.3"
  }
}
