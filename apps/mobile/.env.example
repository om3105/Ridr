# Use your computer's LAN address for a physical phone on the same network.
# Android emulator: http://10.0.2.2:3000 ; iOS simulator/web: http://localhost:3000
# This value is public and embedded in the app. Never put credentials here.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Local HTTP is permitted only in the development native configuration.
# Set production before generating any production native project.
APP_VARIANT=development

# Public Auth URL and publishable/anon key from Supabase Project Settings > API Keys.
EXPO_PUBLIC_SUPABASE_AUTH_URL=https://your-project.supabase.co/auth/v1
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-key
# Optional. Without a key, the native map uses an authored sample, not real roads.
EXPO_PUBLIC_MAPTILER_KEY=
