# Local-only values. `npm run setup` generates unique passwords in ignored .env.
POSTGRES_PASSWORD=replace-with-local-admin-password
RIDR_MIGRATOR_PASSWORD=replace-with-local-migrator-password
RIDR_API_PASSWORD=replace-with-local-api-password
MIGRATION_DATABASE_URL=postgresql://ridr_migrator:replace-with-local-migrator-password@127.0.0.1:55432/ridr
DATABASE_URL=postgresql://ridr_api:replace-with-local-api-password@127.0.0.1:55432/ridr
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MONITOR_API_URL=http://127.0.0.1:3000
# Supabase project and MapTiler credentials are configured with Day 5.
# Never put backend secrets into EXPO_PUBLIC_* variables.
