# Local-only values. `npm run setup` generates unique passwords in ignored .env.
POSTGRES_PASSWORD=replace-with-local-admin-password
RIDR_MIGRATOR_PASSWORD=replace-with-local-migrator-password
RIDR_API_PASSWORD=replace-with-local-api-password
MIGRATION_DATABASE_URL=postgresql://ridr_migrator:replace-with-local-migrator-password@127.0.0.1:55432/ridr
DATABASE_URL=postgresql://ridr_api:replace-with-local-api-password@127.0.0.1:55432/ridr
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
MONITOR_API_URL=http://127.0.0.1:3000
# Per-process invitation/create throttles. Multi-instance hosting needs a shared limiter.
INVITE_ACCOUNT_PER_MINUTE=30
INVITE_IP_PER_MINUTE=120
# Never put backend secrets into EXPO_PUBLIC_* variables.
# Configure both values together after auth/session-access.sql is installed in Supabase.
# SUPABASE_AUTH_URL=https://your-project.supabase.co/auth/v1
# AUTH_DATABASE_URL=postgresql://ridr_auth_reader:password@host:5432/postgres?sslmode=verify-full
# Local Auth tests use a separate ignored .env.auth, created by npm run auth:setup.

# Optional local Pune road routing. Prepare/start using docs/day-08/README.md.
ROUTING_DRIVING_URL=http://127.0.0.1:5001
ROUTING_CYCLING_URL=http://127.0.0.1:5002
